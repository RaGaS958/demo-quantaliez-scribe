# Copy to .env. With no key the demo runs OFFLINE on the built-in sample consultations.

# --- Live AI (optional) -----------------------------------------------------------------
# A Groq key turns on the microphone / audio upload and live clinical understanding,
# using open-weight models (Whisper large-v3 + gpt-oss-120b).
GROQ_API_KEY=

# Point these at vLLM (or any OpenAI-compatible server) inside NHA cloud for a production-like run.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3

# Leave empty to auto-detect the language, or force one, e.g. hi or en
# STT_LANGUAGE=

# Set true to always use the cached sample drafts (safest choice for a presentation)
# OFFLINE_DEMO=false

# PORT=8000

# --- Your doctor and clinic details, printed on reports (empty = demo values) ------------
# DOCTOR_NAME=Dr. Your Name
# DOCTOR_QUALIFICATION=MBBS, MD (Medicine)
# DOCTOR_REGISTRATION=State Medical Council Reg. No.
# DOCTOR_HPR_ID=
# FACILITY_NAME=Your Clinic Name
# FACILITY_ADDRESS=Street, City, State PIN
# FACILITY_PHONE=+91 ...
# FACILITY_HFR_ID=

# --- Optional: LiveKit ambient capture (python -m voice_agent.ambient_scribe console) ------
# LIVEKIT_URL=wss://your-project-id.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# SCRIBE_SERVER_URL=http://127.0.0.1:8000
